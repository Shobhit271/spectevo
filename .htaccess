
RewriteEngine on

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home2/spectevo/spectevo"
PassengerBaseURI "/"
PassengerPython "/home2/spectevo/virtualenv/spectevo/2.7/bin/python2.7"
PassengerAppLogFile "/home2/spectevo/logs.passengar.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
RewriteEngine on
RewriteCond %{HTTP_HOST} ^www.spectevo.com/ 
RewriteRule (.*) https://spectevo.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^spectevo\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.spectevo\.com$
RewriteRule ^/?$ "Https\:\/\/spectevo\.com\/" [R=301,L]


<Files 403.shtml>
order allow,deny
allow from all
</Files>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php72” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php72 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
